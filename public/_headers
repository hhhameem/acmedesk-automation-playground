# Response headers for static files (Cloudflare Workers static assets format).

# Build output has content hashes in its file names, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons change rarely; cache for a week and refresh in the background.
/screens/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Always revalidate the mock service worker so app updates take effect.
/mockServiceWorker.js
  Cache-Control: no-cache

# The static iframe documents are not pages to index.
/embed/*
  X-Robots-Tag: noindex

# Basic hardening.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
